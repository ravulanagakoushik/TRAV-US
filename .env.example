# ==========================================
# RouteRescue AI - Environment Configuration
# ==========================================

# -----------------
# FRONTEND CONFIG
# -----------------
# Base URL for the Express API
VITE_API_BASE_URL=http://localhost:4000/api

# Public Supabase credentials for client-side Auth
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# -----------------
# BACKEND CONFIG
# -----------------
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Server-Side Configuration (PostgreSQL & Auth validation)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Note: Keep service role key blank unless explicit trusted admin maintenance is required.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI Configuration
# Get key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Road Routing Engine (Default is built-in deterministic road network estimator)
# Example OSRM: http://router.project-osrm.org
ROUTING_BASE_URL=
